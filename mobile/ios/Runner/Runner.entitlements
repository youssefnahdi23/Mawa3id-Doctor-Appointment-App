<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Push Notification environment. This file is wired into the Runner
	     target's CODE_SIGN_ENTITLEMENTS build setting (Debug/Release/Profile).
	     Kept as `development` here so local/debug builds and the iOS Simulator work
	     without an App Store profile. The release-build CI (release-build.yml) flips
	     this to `production` on a build-time copy before archiving the signed IPA. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
