# Dart / Flutter tooling
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Generated sources — rebuilt in CI (flutter gen-l10n + build_runner)
lib/l10n/gen/
*.g.dart

# IDE cruft
.idea/
*.iml

# Coverage output
coverage/

# Firebase native config (push notifications) — provided per environment, never committed.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Fastlane runtime cruft + secrets
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/play-service-account.json

# Store screenshots are regenerated by the screenshot harness in CI and consumed
# by the upload lane in the same run, so the (large, binary) PNGs are not committed.
android/fastlane/metadata/android/*/images/phoneScreenshots/*.png
ios/fastlane/screenshots/**/*.png
