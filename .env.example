# Copy to .env and fill in real values: cp .env.example .env
# docker-compose.yml reads these. Do NOT commit your real .env.

# --- Database ---
DB_NAME=mawa3id
DB_USERNAME=mawa3id
# Set a strong password (used by both the db and app services).
DB_PASSWORD=change-me

# --- Security ---
# Base64-encoded key, >= 256 bits. Generate one, e.g.:
#   openssl rand -base64 48
# Leave blank only for throwaway local runs (then set JWT_FAIL_ON_MISSING_SECRET=false).
JWT_SECRET=
JWT_FAIL_ON_MISSING_SECRET=true

# --- App ---
# IANA clinic time zone used for all "now" comparisons (slots, reminders).
CLINIC_ZONE=UTC
SERVER_PORT=8080

# --- TLS / reverse proxy (Caddy) ---
# Public hostname Caddy serves. Leave as 'localhost' for local HTTPS (self-signed).
# Set to your real domain in production to auto-provision a Let's Encrypt cert.
# (For an optional Let's Encrypt contact email, edit the `email` line in ./Caddyfile.)
DOMAIN=localhost

# --- Donations (optional) ---
DONATIONS_ENABLED=true
PATREON_URL=
# International card (Stripe hosted Checkout).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Konnect — Tunisian aggregator (D17, Flouci wallet, local cards). The method is
# offered only when both values below are set. Get them from the Konnect dashboard
# (https://konnect.network); point KONNECT_BASE_URL at the sandbox while testing.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# KONNECT_BASE_URL=https://api.konnect.network/api/v2
# Public callback Konnect invokes with ?payment_ref= once a payment settles,
# e.g. https://your-domain.com/api/donations/konnect/webhook
KONNECT_WEBHOOK_URL=
# Manual bank transfer: shown to donors when RIB_NUMBER is set.
RIB_ACCOUNT_HOLDER=
RIB_BANK_NAME=
RIB_NUMBER=

# --- Push notifications (optional; Firebase Cloud Messaging) ---
# Push degrades to a no-op unless FCM_CREDENTIALS is set, so the app runs without Firebase.
# FCM_CREDENTIALS is the Firebase service-account JSON, inline (single line). Get it from
# Firebase console > Project settings > Service accounts > Generate new private key.
FCM_ENABLED=true
FCM_CREDENTIALS=
# Optional; usually inferred from the credentials.
FCM_PROJECT_ID=
